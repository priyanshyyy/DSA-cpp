<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Have a Look</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#ffffff;
    padding:20px;
}

h1,h2{
    text-align:center;
    margin:20px 0;
}

#products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:#53a8bd;
    border-radius:10px;
    padding:15px;
    text-align:center;
    box-shadow:0 2px 10px rgba(0,0,0,.2);
}

.card img{
    width:180px;
    height:180px;
    object-fit:contain;
}

button{
    margin-top:10px;
    padding:10px 15px;
    border:none;
    border-radius:5px;
    background:#002b3f;
    color:rgb(254, 255, 255);
    cursor:pointer;
}

button:hover{
    background:#59a1ed;
}

#productDetails,#cartSection{
    display:none;
    margin-top:30px;
    background:rgb(0, 41, 53);
    padding:20px;
    border-radius:10px;
}

#cartItems{
    margin-top:20px;
}

.cartItem{
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid #ccc;
    padding:10px 0;
}

.bill{
    margin-top:20px;
    background:#eee;
    padding:15px;
    border-radius:10px;
}

.backBtn{
    background:#53a8bd;
    margin-bottom:15px;
}
</style>

</head>
<body>

<h1>Have a Look</h1>

<div style="text-align:center;margin-bottom:20px;">
<button onclick="showCart()">🛒 View Bag</button>
</div>

<div id="products"></div>

<div id="productDetails"></div>

<div id="cartSection">
<h2>Cart</h2>

<div id="cartItems"></div>

<div class="bill" id="billSummary"></div>

<button class="backBtn" onclick="backToProducts()">Back to Shopping</button>

</div>

<script>

let cart=[];

// Fetch all products

fetch("https://dummyjson.com/products?limit=194")
.then(res=>res.json())
.then(data=>{

let products=document.getElementById("products");

data.products.forEach(product=>{

products.innerHTML+=`

<div class="card">

<img src="${product.thumbnail}">

<h3>${product.title}</h3>

<p><b>₹ ${product.price}</b></p>

<p>⭐ ${product.rating}</p>

<button onclick="viewProduct(${product.id})">
View Details
</button>

</div>

`;

});

});

// View Product

function viewProduct(id){

fetch(`https://dummyjson.com/products/${id}`)

.then(res=>res.json())

.then(product=>{

document.getElementById("products").style.display="none";

document.getElementById("cartSection").style.display="none";

let details=document.getElementById("productDetails");

details.style.display="block";

details.innerHTML=`

<button class="backBtn" onclick="backToProducts()">
⬅ Back
</button>

<div class="card">

<img src="${product.thumbnail}">

<h2>${product.title}</h2>

<p>${product.description}</p>

<p><b>Brand:</b> ${product.brand}</p>

<p><b>Category:</b> ${product.category}</p>

<p><b>Price:</b> ₹${product.price}</p>

<p><b>Rating:</b> ⭐${product.rating}</p>

<p><b>Stock:</b> ${product.stock}</p>

<button onclick='addToCart(${JSON.stringify(product)})'>
Add To Cart
</button>

</div>

`;

});

}

// Add to Cart

function addToCart(product){

cart.push(product);

alert("Product Added Successfully!");

}

// Show Cart

function showCart(){

document.getElementById("products").style.display="none";

document.getElementById("productDetails").style.display="none";

document.getElementById("cartSection").style.display="block";

let cartItems=document.getElementById("cartItems");

cartItems.innerHTML="";

let total=0;

cart.forEach(item=>{

total+=item.price;

cartItems.innerHTML+=`

<div class="cartItem">

<div>

<h3>${item.title}</h3>

<p>₹ ${item.price}</p>

</div>

<img src="${item.thumbnail}" width="80">

</div>

`;

});

document.getElementById("billSummary").innerHTML=`

<h3>Bill Summary</h3>

<p>Total Items : ${cart.length}</p>

<p>Subtotal : ₹${total}</p>

<p>Shipping : ₹30</p>

<p>Discount : ₹0</p>

<hr>

<h2>Grand Total : ₹${total+30}</h2>

`;

}

// Back

function backToProducts(){

document.getElementById("products").style.display="grid";

document.getElementById("productDetails").style.display="none";

document.getElementById("cartSection").style.display="none";

}

</script>

</body>
</html>